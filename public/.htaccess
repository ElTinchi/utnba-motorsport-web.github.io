# Apache / cPanel. Las rutas públicas se publican como HTML estático durante el
# build; solo las URLs históricas necesitan redirección del servidor.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
  RewriteRule ^(?:sobre-nosotros|equipo)/?$ /el-equipo [R=301,L,NE]
  RewriteRule ^motorsport/?$ /la-academia [R=301,L,NE]
  RewriteRule ^contacto/?$ /sumate [R=301,L,NE]
</IfModule>

ErrorDocument 404 /404.html
AddType application/xml .xml

# Los assets van con hash en el nombre: se pueden cachear para siempre.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Las imágenes y el modelo 3D mantienen su nombre al reemplazarse: una semana
  # alcanza para que los cambios lleguen sin forzar a bajarlos en cada visita.
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType model/gltf-binary "access plus 1 week"
</IfModule>

# El modelo del auto es el archivo más pesado del sitio; sin esto viaja sin comprimir.
AddType model/gltf-binary .glb
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE model/gltf-binary
</IfModule>

# index.html nunca se cachea, para que un deploy se vea al instante.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(visor\.html|visor\.js|engine\.js|undertray\.js|zones\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
